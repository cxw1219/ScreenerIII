# Bandit configuration for ScreenerIII
# https://bandit.readthedocs.io/

[bandit]
# Exclude test files and virtual environments
exclude_dirs =
    .git,
    __pycache__,
    .venv,
    venv,
    env,
    .tox,
    .pytest_cache,
    .mypy_cache,
    build,
    dist,
    tests,

# Test IDs to run (comment out to disable specific tests)
tests =
    B201,
    B301,
    B302,
    B303,
    B304,
    B305,
    B306,
    B307,
    B308,
    B309,
    B310,
    B311,
    B312,
    B313,
    B314,
    B315,
    B316,
    B317,
    B318,
    B319,
    B320,
    B321,
    B322,
    B323,
    B324,
    B325,
    B401,
    B402,
    B403,
    B404,
    B405,
    B406,
    B407,
    B408,
    B409,
    B410,
    B411,
    B501,
    B502,
    B503,
    B504,
    B505,
    B506,
    B507,
    B601,
    B602,
    B603,
    B604,
    B605,
    B606,
    B607,
    B608,
    B609,
    B610,
    B611,
    B701,
    B702,
    B703,
    B704,
    B705,

# Skip test IDs (comment out to disable skipping)
skips =

# Recursively scan directories for Python files
recursive = true

[bandit:assert_used]
# Skipping assert_used checks - they're expected in tests

[bandit:hardcoded_sql_string]
# Check for hardcoded SQL strings

[bandit:hardcoded_password_string]
# Patterns to look for hardcoded passwords
word_list = password,passwd,pwd,secret,token,api_key,apikey,access_token,auth,credentials

# OANDA API Configuration
OANDA_API_TOKEN=your_api_token_here
OANDA_ACCOUNT_ID=your_account_id_here
OANDA_ENVIRONMENT=practice

# Database Configuration
# DATABASE_URL supports both SQLite and PostgreSQL/TimescaleDB
# The application will auto-detect the database type from the connection string

# --- Development: SQLite (lightweight, no setup required) ---
# Uncomment this for local development with SQLite
# DATABASE_URL=sqlite:///screener.db

# --- Production: TimescaleDB / PostgreSQL ---
# Use this for production with TimescaleDB (time-series optimized PostgreSQL)
DATABASE_URL=postgresql://screener_user:screener_password@localhost:5432/screener_db

# TimescaleDB Configuration (Docker or local installation)
POSTGRES_DB=screener_db
POSTGRES_USER=screener_user
POSTGRES_PASSWORD=screener_password
TIMESCALEDB_PORT=5432

# Database Connection Pool Settings (PostgreSQL/TimescaleDB only, optional)
# DATABASE_POOL_SIZE=5        # Number of permanent connections to keep
# DATABASE_MAX_OVERFLOW=10    # Max additional connections when pool is full
# DATABASE_ECHO=false         # Set to 'true' to log all SQL queries (debug mode)

# --- Cloud TimescaleDB Example ---
# For Timescale Cloud or other managed TimescaleDB:
# DATABASE_URL=postgresql://username:password@your-instance.timescaledb.io:5432/tsdb?sslmode=require

# pgAdmin Configuration (optional, for database management UI)
PGADMIN_EMAIL=admin@screener.local
PGADMIN_PASSWORD=admin_password
PGADMIN_PORT=5050

# Application Configuration
UPDATE_INTERVAL=10
LOG_LEVEL=INFO
# APP_ENVIRONMENT=development   # Options: development, production, testing

# Docker Configuration
COMPOSE_PROJECT_NAME=screeneriii

# ============================================================
# Alert System Configuration
# ============================================================

# Alert Channels (enable/disable each notification channel)
ALERT_ENABLE_EMAIL=false      # Enable email alerts
ALERT_ENABLE_DESKTOP=true     # Enable desktop notifications
ALERT_ENABLE_TELEGRAM=false   # Enable Telegram alerts

# Alert Thresholds
ALERT_MIN_CONFIDENCE=0.7      # Minimum confidence for signal alerts (0.0-1.0)

# Email Configuration (SMTP)
# For Gmail: Use app-specific password (https://myaccount.google.com/apppasswords)
# For other providers: Check their SMTP settings
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USE_TLS=true
EMAIL_USERNAME=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_FROM=your_email@gmail.com
EMAIL_TO=recipient1@example.com,recipient2@example.com  # Comma-separated

# Telegram Configuration
# To get bot token: Talk to @BotFather on Telegram
# To get chat ID: Send a message to your bot, then visit:
# https://api.telegram.org/bot<YOUR_BOT_TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here  # Comma-separated for multiple chats

# Alert Rate Limiting (prevent spam)
ALERT_RATE_LIMIT_SECONDS=300  # Minimum seconds between similar alerts (5 minutes)
ALERT_MAX_PER_HOUR=20         # Maximum alerts per hour per type

# Desktop Notification Settings
ALERT_DESKTOP_SOUND=true      # Enable sound for desktop notifications
ALERT_DESKTOP_TIMEOUT=10      # Notification display duration (seconds)
